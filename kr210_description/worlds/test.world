<?xml version="1.0" encoding="utf-8"?>

<sdf version='1.6'>
  <world name='default'>
        <physics type="ode">
            <max_step_size>0.01</max_step_size>
        </physics>

        

  
    
    <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        
        <model name="ground_plane">
            <static>true</static>
           <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>
	
	<model name='aws_robomaker_residential_KitchenTable_01'>
        <static>true</static>    
        <include>
            <uri>model://aws_robomaker_residential_KitchenTable_01</uri>
        </include>
        <pose>2.18138 0.208437 -0.312234 -0 1e-06 3.11118</pose>
        
	</model>
	<model name='trash_01'>
        <static>true</static>    
        <include>
            <uri>model://aws_robomaker_residential_Trash_01</uri>
        </include>
        <pose>0.979586 -1.15578 0.006283 0 0 -1.50414</pose>
	</model>

    <model name='vase_01'>
        <include>
            <uri>model://aws_robomaker_residential_Vase_01</uri>
        </include>
        <pose>1.75472 0.650526 0.915964 0 -1e-06 -0</pose>
        
	</model>

  <model name='light'>
        <include>
            <uri>model://aws_robomaker_residential_LightC_01</uri>
        </include>
        <pose>2.14452 -0.613752 0.938973 0 0 0</pose>
	</model>
 
  <model name='camera'>
        <include>
            <uri>model://aws_robomaker_residential_SecurityCamera_01</uri>
        </include>
        <pose>1.99341 0.123495 0.915454 0 0 0</pose>
        
	</model>

    
 


