<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="base_mass" value="15"/>
<xacro:property name="mass1" value="13.8"/>
<xacro:property name="mass2" value="9.5"/>
<xacro:property name="mass3" value="7.1"/>
<xacro:property name="mass4" value="1.7"/>
<xacro:property name="mass5" value="0.7"/>
<xacro:property name="mass6" value="0.05"/>
<xacro:property name="gripper_mass" value="0.03"/>
<xacro:property name="finger_mass" value="0.01"/>




<!-- <link name="world"/> -->




<link name="base_link">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/base_link.dae"/>
        </geometry>
        <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/base_link.stl"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
    </collision>

    <inertial>
        <mass value="${base_mass}"/>
        <inertia ixx="6" ixy="0" ixz="0" iyy="7" iyz="0" izz="10" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
</link>


<link name="link_1">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/link_1.dae"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/link_1.stl"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
        <mass value="${mass1}"/>
        <inertia ixx="3" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
    </inertial>
</link>

<link name="link_2">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/link_2.dae"/>
        </geometry>
        <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/link_2.stl"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
        <mass value="${mass2}"/>
        <inertia ixx="4" ixy="0" ixz="0" iyy="4" iyz="0" izz="1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
</link>

<link name="link_3">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/link_3.dae"/>
        </geometry>
        <origin xyz="0 -0.184 0" rpy="${-pi/2} 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/link_3.stl"/>
        </geometry>
        <origin xyz="0 -0.184 0" rpy="0 0 0"/>
    </collision>

    <inertial>
        <mass value="${mass3}"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
        <origin xyz="0.18842 0.18344 -0.042799" rpy="0 0 0"/>
    </inertial>
</link>

<link name="link_4">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/link_4.dae"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/link_4.stl"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
        <mass value="${mass4}"/>
        <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.055" iyz="0" izz="0.064"/>
        <origin xyz="0.27146 -0.007326 0" rpy="0 0 0"/>
    </inertial>
</link>

<link name="link_5">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/link_5.dae"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/link_5.stl"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
        <mass value="${mass5}"/>
        <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.0068" iyz="0" izz="0.0068"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
</link>

<link name="link_6">
    <visual>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/visual/link_6.dae"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <collision>
        <geometry>
            <mesh filename="file://$(find kr210_description)/meshes/kr210l150/collision/link_6.stl"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
        <mass value="${mass6}"/>
        <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
</link>





<!-- <joint name="fixed_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    
</joint> -->

<joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.33" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-185.0 * (pi / 180.0)}" upper="${185.0 * (pi / 180.0)}" effort="300" velocity="${123.0 * (pi / 180.0)}"/>
    <dynamics friction="0" damping="10"/>
</joint>

<joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.35 0 0.42" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-45*pi/180}" upper="${85*pi/180}" effort="300" velocity="${115*pi/180}"/>
    <dynamics friction="0" damping="10"/>
</joint>

<joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 1.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-210*pi/180}" upper="${65*pi/180}" effort="3000" velocity="${112 * pi/180}"/>
    <dynamics friction="0" damping="10"/>
</joint>

<joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.96 0 -0.054" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-125 * pi/180}" upper="${125*pi/180}" effort="3000" velocity="${179*pi/180}"/>
    <dynamics friction="0" damping="10"/>
</joint>

<joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.54 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-125 * pi/180}" upper="${125*pi/180}" effort="3000" velocity="${172*pi/180}"/>
    <dynamics friction="0" damping="10"/>
</joint>

<joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.193 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-350*pi/180}" upper="${350*pi/180}" effort="3000" velocity="${219*pi/180}"/>
    <dynamics friction="0" damping="10"/>
</joint> 






</robot>
